       EXEC SQL
DECLARE C-DEPT-EMPLOYEE CURSOR FOR
SELECT DA_STARTDATE_479OYEE,
       DA_TERMINATIONDATE_479OYEE,
       DA_BIRTHDATE_479OYEE,
       EMP_ID_479OYEE,
       EMP_FIRSTNAME_479OYEE,
       EMP_LASTNAME_479OYEE,
       EMP_STREET_479OYEE,
       EMP_CITY_479OYEE,
       EMP_STATE_479OYEE,
       EMP_ZIPFIRSTFIVE_479OYEE,
       EMP_ZIPLASTFOUR_479OYEE,
       EMP_PHONE_479OYEE,
       STATUS_479OYEE,
       SS_NUMBER_479OYEE,
       DEPT_ID_479MENT,
       OFFICE_CODE_479FICE
FROM EMPLOYEE
WHERE DEPT_ID_479MENT = :HV-DEPARTMENT-DEPT-ID-479MENT
ORDER BY DEPT_ID_479MENT
END-EXEC.

PROCEDURE DIVISION.
****************************************************************
* PROCEDURE DIVISION GENERAL STRATEGY: *
* *
* 1) READ DEPT-ID-IN, WHICH CONTAINS THE *
* DEPT-ID NUMBER *
* *
* 2) ACCESS THE DATABASE USING THE DEPT-ID NUMBER *
* WITH AN OBTAIN CALC ON THE DEPARTMENT RECORD *
* *
* 3) ACCESS ALL EMPLOYEES IN THE DEPT-EMPLOYEE SET *
* AND RETRIEVE RELATED JOB AND OFFICE DATA *
* *
* 4) PRINT A REPORT FOR EACH DEPARTMENT *
* *
* 5) PRINT AN ERROR REPORT FOR EMPTY DEPARTMENTS *
* AND NONEXISTENT DEPARTMENTS (NO MATCHING *
* DEPT-ID) *
****************************************************************
FETCH-DEPT-EMPLOYEE.
       EXEC SQL
            FETCH C-DEPT-EMPLOYEE
            INTO :HV-EMPLOYEE-DA-STARTDATE-479OYEE :NI-EMPLOYEE-DA-STARTDATE-479OYEE,
                :HV-EMPLOYEE-DA-TERMINATIONDATE-479OYEE :NI-EMPLOYEE-DA-TERMINATIONDATE-479OYEE,
                :HV-EMPLOYEE-DA-BIRTHDATE-479OYEE :NI-EMPLOYEE-DA-BIRTHDATE-479OYEE,
                :HV-EMPLOYEE-EMP-ID-479OYEE,
                :HV-EMPLOYEE-EMP-FIRSTNAME-479OYEE :NI-EMPLOYEE-EMP-FIRSTNAME-479OYEE,
                :HV-EMPLOYEE-EMP-LASTNAME-479OYEE :NI-EMPLOYEE-EMP-LASTNAME-479OYEE,
                :HV-EMPLOYEE-EMP-STREET-479OYEE :NI-EMPLOYEE-EMP-STREET-479OYEE,
                :HV-EMPLOYEE-EMP-CITY-479OYEE :NI-EMPLOYEE-EMP-CITY-479OYEE,
                :HV-EMPLOYEE-EMP-STATE-479OYEE :NI-EMPLOYEE-EMP-STATE-479OYEE,
                :HV-EMPLOYEE-EMP-ZIPFIRSTFIVE-479OYEE :NI-EMPLOYEE-EMP-ZIPFIRSTFIVE-479OYEE,
                :HV-EMPLOYEE-EMP-ZIPLASTFOUR-479OYEE :NI-EMPLOYEE-EMP-ZIPLASTFOUR-479OYEE,
                :HV-EMPLOYEE-EMP-PHONE-479OYEE :NI-EMPLOYEE-EMP-PHONE-479OYEE,
                :HV-EMPLOYEE-STATUS-479OYEE :NI-EMPLOYEE-STATUS-479OYEE,
                :HV-EMPLOYEE-SS-NUMBER-479OYEE :NI-EMPLOYEE-SS-NUMBER-479OYEE,
                :HV-EMPLOYEE-DEPT-ID-479MENT :NI-EMPLOYEE-DEPT-ID-479MENT,
                :HV-EMPLOYEE-OFFICE-CODE-479FICE :NI-EMPLOYEE-OFFICE-CODE-479FICE
       END-EXEC.
       IF SQLCODE NOT = 0 AND SQLCODE NOT = 100
       PERFORM SQL-ERROR
       END-IF.
MAIN-LINE.
       PERFORM INIT-FILES.
       IF END-OF-FILE
       PERFORM EMPTY-INPUT-PROCESSING
       ELSE
       PERFORM INIT-DB2-SETUP
       PERFORM U220-ERR-HEADER
       PERFORM DEPT-PROCESSING THRU DEPT-PROCESSING-EXIT
           UNTIL END-OF-FILE.
       PERFORM END-PROCESSING.
       GOBACK.
INIT-DB2-SETUP.
       CONTINUE.
INIT-FILES.
       OPEN INPUT DEPT-FILE-IN.
       OPEN OUTPUT DEPT-FILE-OUT.
       OPEN OUTPUT ERR-FILE-OUT.
       MOVE SPACES TO PRINT-LINE.
       MOVE SPACES TO ERR-LINE.
       READ DEPT-FILE-IN
          AT END MOVE 'Y' TO EOF-SW.
EMPTY-INPUT-PROCESSING.
       MOVE NO-INPUT-MESSAGE TO PRINT-LINE.
       MOVE '1' TO CC.
       PERFORM U000-WRITE-LINE.
****************************************************************
* THIS PARAGRAPH ACCESSES THE DATABASE USING THE DEPT-ID-0415 *
* CALCKEY VALUE. *
****************************************************************
DEPT-PROCESSING.
       MOVE DEPT-ID-IN TO HV-DEPARTMENT-DEPT-ID-479MENT.
       EXEC SQL
            SELECT DEPT_ID_479MENT,
                DEPT_NAME_479MENT,
                DEPT_HEADID_479MENT
            INTO :HV-DEPARTMENT-DEPT-ID-479MENT,
                :HV-DEPARTMENT-DEPT-NAME-479MENT :NI-DEPARTMENT-DEPT-NAME-479MENT,
                :HV-DEPARTMENT-DEPT-HEADID-479MENT :NI-DEPARTMENT-DEPT-HEADID-479MENT
            FROM DEPARTMENT
            WHERE DEPT_ID_479MENT = :HV-DEPARTMENT-DEPT-ID-479MENT
       END-EXEC.
       IF SQLCODE = 100
       PERFORM NO-DEPT-PROCESSING
       ELSE IF SQLCODE NOT = 0
       PERFORM SQL-ERROR
       ELSE
       EXEC SQL
            OPEN C-DEPT-EMPLOYEE
       END-EXEC.
       IF SQLCODE NOT = 0
       PERFORM SQL-ERROR
       ELSE
       PERFORM FETCH-DEPT-EMPLOYEE

       IF SQLCODE = 100
       PERFORM EMPTY-SET
       ELSE
       PERFORM U020-VALID-HEADER
       MOVE HV-DEPARTMENT-DEPT-ID-479MENT TO DEPT-ID-OUT
       MOVE HV-DEPARTMENT-DEPT-NAME-479MENT TO DEPT-NAME-OUT
       MOVE DEPT-DETAIL-LINE TO PRINT-LINE
       PERFORM U000-WRITE-LINE
       PERFORM U030-EMP-HEADERS

       PERFORM UNTIL SQLCODE = 100
       PERFORM SET-WALK THRU SET-WALK-EXIT
       PERFORM FETCH-DEPT-EMPLOYEE
       END-PERFORM
       END-IF.
       EXEC SQL
            CLOSE C-DEPT-EMPLOYEE
       END-EXEC.
       END-IF.
       END-IF.
       END-IF.
       READ DEPT-FILE-IN
          AT END MOVE 'Y' TO EOF-SW.
DEPT-PROCESSING-EXIT.
       EXIT.
****************************************************************
* THIS PARAGRAPH RETRIEVES EMPLOYEE, JOB, AND OFFICE DATA *
* FOR EACH EMPLOYEE IN THE DEPT-EMPLOYEE SET. *
****************************************************************
SET-WALK.
       CONTINUE.
       MOVE HV-EMPLOYEE-EMP-ID-479OYEE TO ID-OUT.
       MOVE HV-EMPLOYEE-EMP-LASTNAME-479OYEE TO LAST-OUT.
       MOVE HV-EMPLOYEE-EMP-FIRSTNAME-479OYEE TO FIRST-OUT.
       MOVE HV-EMPLOYEE-DA-STARTDATE-479OYEE(3:2) TO SD-YY.
       MOVE HV-EMPLOYEE-DA-STARTDATE-479OYEE(6:2) TO SD-MM.
       MOVE HV-EMPLOYEE-DA-STARTDATE-479OYEE(9:2) TO SD-DD.
       EXEC SQL
            SELECT ID_RECORD_TION,
                DA_STARTDATE_479TION,
                DA_FINISHDATE_479TION,
                SALARY_GRADE_479TION,
                SALARY_AMOUNT_479TION,
                BONUS_PERCENT_479TION,
                COMMISSION_PERCENT_479TION,
                OVERTIME_RATE_479TION,
                EMP_ID_479OYEE,
                JOB_ID_479JOB
            INTO :HV-EMPOSITION-ID-RECORD-TION,
                :HV-EMPOSITION-DA-STARTDATE-479TION :NI-EMPOSITION-DA-STARTDATE-479TION,
                :HV-EMPOSITION-DA-FINISHDATE-479TION :NI-EMPOSITION-DA-FINISHDATE-479TION,
                :HV-EMPOSITION-SALARY-GRADE-479TION :NI-EMPOSITION-SALARY-GRADE-479TION,
                :HV-EMPOSITION-SALARY-AMOUNT-479TION :NI-EMPOSITION-SALARY-AMOUNT-479TION,
                :HV-EMPOSITION-BONUS-PERCENT-479TION :NI-EMPOSITION-BONUS-PERCENT-479TION,
                :HV-EMPOSITION-COMMISSION-PERCENT-479TION :NI-EMPOSITION-COMMISSION-PERCENT-479TION,
                :HV-EMPOSITION-OVERTIME-RATE-479TION :NI-EMPOSITION-OVERTIME-RATE-479TION,
                :HV-EMPOSITION-EMP-ID-479OYEE :NI-EMPOSITION-EMP-ID-479OYEE,
                :HV-EMPOSITION-JOB-ID-479JOB :NI-EMPOSITION-JOB-ID-479JOB
            FROM EMPOSITION
            WHERE EMP_ID_479OYEE = :HV-EMPLOYEE-EMP-ID-479OYEE
            ORDER BY EMP_ID_479OYEE
            FETCH FIRST 1 ROW ONLY
       END-EXEC.
       IF SQLCODE = 100
       MOVE NO-JOB-MESSAGE TO TITLE-OUT
       ELSE IF SQLCODE NOT = 0
       PERFORM SQL-ERROR
       ELSE
       EXEC SQL
            SELECT JOB_ID_479JOB,
                TITLE_479JOB,
                DESCRIPTION_LINE_479JOB,
                REQUIREMENT_LINE_479JOB,
                MINIMUM_SALARY_479JOB,
                MAXIMUM_SALARY_479JOB,
                SALARY_GRADES_479JOB,
                NUMBER_OFPOSITIONS_479JOB,
                NUMBER_OPEN_479JOB
            INTO :HV-JOB-JOB-ID-479JOB,
                :HV-JOB-TITLE-479JOB :NI-JOB-TITLE-479JOB,
                :HV-JOB-DESCRIPTION-LINE-479JOB :NI-JOB-DESCRIPTION-LINE-479JOB,
                :HV-JOB-REQUIREMENT-LINE-479JOB :NI-JOB-REQUIREMENT-LINE-479JOB,
                :HV-JOB-MINIMUM-SALARY-479JOB :NI-JOB-MINIMUM-SALARY-479JOB,
                :HV-JOB-MAXIMUM-SALARY-479JOB :NI-JOB-MAXIMUM-SALARY-479JOB,
                :HV-JOB-SALARY-GRADES-479JOB :NI-JOB-SALARY-GRADES-479JOB,
                :HV-JOB-NUMBER-OFPOSITIONS-479JOB :NI-JOB-NUMBER-OFPOSITIONS-479JOB,
                :HV-JOB-NUMBER-OPEN-479JOB :NI-JOB-NUMBER-OPEN-479JOB
            FROM JOB
            WHERE JOB_ID_479JOB = :HV-EMPOSITION-JOB-ID-479JOB
       END-EXEC.
       IF SQLCODE = 100
       MOVE NO-JOB-MESSAGE TO TITLE-OUT
       ELSE IF SQLCODE NOT = 0
       PERFORM SQL-ERROR
       ELSE
       CONTINUE.
       END-IF.
       END-IF.
       END-IF.
       END-IF.
       MOVE HV-JOB-TITLE-479JOB TO TITLE-OUT.
       IF NI-EMPLOYEE-OFFICE-CODE-479FICE < 0
       MOVE NO-OFFICE-MESSAGE TO STREET-OUT
       MOVE SPACES TO CITY-OUT
       MOVE SPACES TO STATE-OUT
       MOVE SPACES TO ZIP-OUT
       ELSE
       EXEC SQL
            SELECT OFFICE_CODE_479FICE,
                OFFICE_STREET_479FICE,
                OFFICE_CITY_479FICE,
                OFFICE_STATE_479FICE,
                OFFICE_ZIPFIRSTFIVE_479FICE,
                OFFICE_ZIPLASTFOUR_479FICE,
                OFFICE_PHONE_479FICE,
                OFFICE_AREACODE_479FICE,
                SPEED_DIAL_479FICE
            INTO :HV-OFFICE-OFFICE-CODE-479FICE,
                :HV-OFFICE-OFFICE-STREET-479FICE :NI-OFFICE-OFFICE-STREET-479FICE,
                :HV-OFFICE-OFFICE-CITY-479FICE :NI-OFFICE-OFFICE-CITY-479FICE,
                :HV-OFFICE-OFFICE-STATE-479FICE :NI-OFFICE-OFFICE-STATE-479FICE,
                :HV-OFFICE-OFFICE-ZIPFIRSTFIVE-479FICE :NI-OFFICE-OFFICE-ZIPFIRSTFIVE-479FICE,
                :HV-OFFICE-OFFICE-ZIPLASTFOUR-479FICE :NI-OFFICE-OFFICE-ZIPLASTFOUR-479FICE,
                :HV-OFFICE-OFFICE-PHONE-479FICE :NI-OFFICE-OFFICE-PHONE-479FICE,
                :HV-OFFICE-OFFICE-AREACODE-479FICE :NI-OFFICE-OFFICE-AREACODE-479FICE,
                :HV-OFFICE-SPEED-DIAL-479FICE :NI-OFFICE-SPEED-DIAL-479FICE
            FROM OFFICE
            WHERE OFFICE_CODE_479FICE = :HV-EMPLOYEE-OFFICE-CODE-479FICE
       END-EXEC.
       IF SQLCODE = 0
       CONTINUE.
       ELSE
       MOVE NO-OFFICE-MESSAGE TO STREET-OUT
       MOVE SPACES TO CITY-OUT
       MOVE SPACES TO STATE-OUT
       MOVE SPACES TO ZIP-OUT
       END-IF.
       END-IF.
       MOVE HV-OFFICE-OFFICE-STREET-479FICE TO STREET-OUT
       MOVE HV-OFFICE-OFFICE-CITY-479FICE TO CITY-OUT
       MOVE HV-OFFICE-OFFICE-STATE-479FICE TO STATE-OUT
       MOVE HV-OFFICE-OFFICE-ZIPFIRSTFIVE-479FICE TO ZIP-OUT
       MOVE EMP-DETAIL-LINE TO PRINT-LINE.
       PERFORM U000-WRITE-LINE.
SET-WALK-EXIT.
       EXIT.
END-PROCESSING.
       CLOSE DEPT-FILE-OUT.
       CLOSE ERR-FILE-OUT.
       CLOSE DEPT-FILE-IN.
EMPTY-SET.
       MOVE SPACES TO ERR-LINE.
       MOVE HV-DEPARTMENT-DEPT-ID-479MENT TO ERR-ID-OUT.
       MOVE NO-EMP-MESSAGE TO ERR-MESS-OUT.
       MOVE ERR-DETAIL-LINE TO ERR-LINE.
       PERFORM U200-WRITE-ERR-LINE.
NO-DEPT-PROCESSING.
       MOVE DEPT-ID-IN TO ERR-ID-OUT.
       MOVE NO-DEPT-MESSAGE TO ERR-MESS-OUT.
       MOVE ERR-DETAIL-LINE TO ERR-LINE.
       PERFORM U200-WRITE-ERR-LINE.
U000-WRITE-LINE.
       WRITE DEPT-REC-OUT AFTER POSITIONING CC.
       IF CC = '1'
          THEN MOVE 0 TO LINE-COUNT
       ELSE IF CC = ' '
          THEN ADD 1 TO LINE-COUNT
       ELSE IF CC = '0'
          THEN ADD 2 TO LINE-COUNT.
       IF LINE-COUNT > LINE-MAX
          THEN PERFORM U010-NEW-PAGE-ROUTINE.
U010-NEW-PAGE-ROUTINE.
       PERFORM U020-VALID-HEADER.
       MOVE DEPT-DETAIL-LINE TO PRINT-LINE.
       PERFORM U000-WRITE-LINE.
       PERFORM U030-EMP-HEADERS.
U020-VALID-HEADER.
       MOVE DEPT-HEADER TO PRINT-LINE.
       MOVE '1' TO CC.
       PERFORM U000-WRITE-LINE.
       MOVE ' ' TO CC.
U030-EMP-HEADERS.
       MOVE '0' TO CC.
       MOVE EMP-HEADER TO PRINT-LINE.
       PERFORM U000-WRITE-LINE.
       MOVE SPACES TO PRINT-LINE.
       MOVE ' ' TO CC.
       PERFORM U000-WRITE-LINE.
U200-WRITE-ERR-LINE.
       WRITE ERR-REC-OUT AFTER POSITIONING ERR-CC.
       IF ERR-CC = '1'
          THEN MOVE 0 TO ERR-LINE-COUNT
       ELSE IF ERR-CC = ' '
          THEN ADD 1 TO ERR-LINE-COUNT
       ELSE IF ERR-CC = '0'
          THEN ADD 2 TO ERR-LINE-COUNT.
       IF ERR-LINE-COUNT > LINE-MAX
       THEN
       PERFORM U220-ERR-HEADER.
U220-ERR-HEADER.
       MOVE ERR-HEADER-1 TO ERR-LINE.
       MOVE '1' TO ERR-CC.
       PERFORM U200-WRITE-ERR-LINE.
       MOVE '0' TO ERR-CC.
       MOVE ERR-HEADER-2 TO ERR-LINE.
       PERFORM U200-WRITE-ERR-LINE.
       MOVE ERR-HEADER-3 TO ERR-LINE.
       PERFORM U200-WRITE-ERR-LINE.
       MOVE SPACES TO ERR-LINE.
       MOVE ' ' TO ERR-CC.
       PERFORM U200-WRITE-ERR-LINE.
SQL-ERROR.
       MOVE SPACES TO ERR-LINE.
       MOVE 'SQL ERROR' TO ERR-MESS-OUT.
       MOVE ERR-DETAIL-LINE TO ERR-LINE.
       PERFORM U200-WRITE-ERR-LINE.
SQL-ERROR-EXIT.
       EXIT.