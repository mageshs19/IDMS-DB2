       EXEC SQL
            DECLARE C-DEPT-EMPLOYEE CURSOR FOR
                SELECT START_DATE_0415,
                       TERMINATION_DATE_0415,
                       BIRTH_DATE_0415,
                       EMP_ID_0415,
                       EMP_FIRST_NAME_0415,
                       EMP_LAST_NAME_0415,
                       EMP_STREET_0415,
                       EMP_CITY_0415,
                       EMP_STATE_0415,
                       EMP_ZIP_FIRST_FIVE_0415,
                       EMP_ZIP_LAST_FOUR_0415,
                       EMP_PHONE_0415,
                       STATUS_0415,
                       SS_NUMBER_0415,
                       DEPT_ID_0410,
                       OFFICE_CODE_0450
                  FROM EMPLOYEE
                 WHERE DEPT_ID_0410 = :HV-DEPARTMENT-DEPT-ID-0410
                 ORDER BY DEPT_ID_0410
       END-EXEC.

PROCEDURE DIVISION.
****************************************************************
* PROCEDURE DIVISION GENERAL STRATEGY: *
* *
* 1) READ DEPT-ID-IN, WHICH CONTAINS THE *
* DEPT-ID NUMBER *
* *
* 2) ACCESS THE DATABASE USING THE DEPT-ID NUMBER *
* WITH AN OBTAIN CALC ON THE DEPARTMENT RECORD *
* *
* 3) ACCESS ALL EMPLOYEES IN THE DEPT-EMPLOYEE SET *
* AND RETRIEVE RELATED JOB AND OFFICE DATA *
* *
* 4) PRINT A REPORT FOR EACH DEPARTMENT *
* *
* 5) PRINT AN ERROR REPORT FOR EMPTY DEPARTMENTS *
* AND NONEXISTENT DEPARTMENTS (NO MATCHING *
* DEPT-ID) *
****************************************************************
FETCH-DEPT-EMPLOYEE.
       EXEC SQL
            FETCH C-DEPT-EMPLOYEE
            INTO :HV-EMPLOYEE-START-DATE-0415,
                :HV-EMPLOYEE-TERMINATION-DATE-0415 :NI-EMPLOYEE-TERMINATION-DATE-0415,
                :HV-EMPLOYEE-BIRTH-DATE-0415 :NI-EMPLOYEE-BIRTH-DATE-0415,
                :HV-EMPLOYEE-EMP-ID-0415,
                :HV-EMPLOYEE-EMP-FIRST-NAME-0415 :NI-EMPLOYEE-EMP-FIRST-NAME-0415,
                :HV-EMPLOYEE-EMP-LAST-NAME-0415 :NI-EMPLOYEE-EMP-LAST-NAME-0415,
                :HV-EMPLOYEE-EMP-STREET-0415 :NI-EMPLOYEE-EMP-STREET-0415,
                :HV-EMPLOYEE-EMP-CITY-0415 :NI-EMPLOYEE-EMP-CITY-0415,
                :HV-EMPLOYEE-EMP-STATE-0415 :NI-EMPLOYEE-EMP-STATE-0415,
                :HV-EMPLOYEE-EMP-ZIP-FIRST-FIVE-0415 :NI-EMPLOYEE-EMP-ZIP-FIRST-FIVE-0415,
                :HV-EMPLOYEE-EMP-ZIP-LAST-FOUR-0415 :NI-EMPLOYEE-EMP-ZIP-LAST-FOUR-0415,
                :HV-EMPLOYEE-EMP-PHONE-0415 :NI-EMPLOYEE-EMP-PHONE-0415,
                :HV-EMPLOYEE-STATUS-0415 :NI-EMPLOYEE-STATUS-0415,
                :HV-EMPLOYEE-SS-NUMBER-0415 :NI-EMPLOYEE-SS-NUMBER-0415,
                :HV-EMPLOYEE-DEPT-ID-0410 :NI-EMPLOYEE-DEPT-ID-0410,
                :HV-EMPLOYEE-OFFICE-CODE-0450 :NI-EMPLOYEE-OFFICE-CODE-0450
       END-EXEC.
       IF SQLCODE NOT = 0 AND SQLCODE NOT = 100
          PERFORM SQL-ERROR
       END-IF.
MAIN-LINE.
       PERFORM INIT-FILES.
       IF END-OF-FILE
       PERFORM EMPTY-INPUT-PROCESSING
       ELSE
       PERFORM INIT-DB2-SETUP
       PERFORM U220-ERR-HEADER
       PERFORM DEPT-PROCESSING THRU DEPT-PROCESSING-EXIT
UNTIL END-OF-FILE.
       PERFORM END-PROCESSING.
       GOBACK.
INIT-DB2-SETUP.
       CONTINUE.
INIT-FILES.
       OPEN INPUT DEPT-FILE-IN.
       OPEN OUTPUT DEPT-FILE-OUT.
       OPEN OUTPUT ERR-FILE-OUT.
       MOVE SPACES TO PRINT-LINE.
       MOVE SPACES TO ERR-LINE.
       READ DEPT-FILE-IN
          AT END MOVE 'Y' TO EOF-SW.
EMPTY-INPUT-PROCESSING.
       MOVE NO-INPUT-MESSAGE TO PRINT-LINE.
       MOVE '1' TO CC.
       PERFORM U000-WRITE-LINE.
****************************************************************
* THIS PARAGRAPH ACCESSES THE DATABASE USING THE DEPT-ID-0415 *
* CALCKEY VALUE. *
****************************************************************
DEPT-PROCESSING.
       MOVE DEPT-ID-IN TO HV-DEPARTMENT-DEPT-ID-0410.
       EXEC SQL
                SELECT DEPT_ID_0410,
                DEPT_NAME_0410,
                DEPT_HEAD_ID_0410
            INTO :HV-DEPARTMENT-DEPT-ID-0410,
                :HV-DEPARTMENT-DEPT-NAME-0410 :NI-DEPARTMENT-DEPT-NAME-0410,
                :HV-DEPARTMENT-DEPT-HEAD-ID-0410 :NI-DEPARTMENT-DEPT-HEAD-ID-0410
            FROM DEPARTMENT
            WHERE DEPT_ID_0410 = :HV-DEPARTMENT-DEPT-ID-0410
       END-EXEC.
       IF SQLCODE = 100
       PERFORM NO-DEPT-PROCESSING
       ELSE
       IF SQLCODE NOT = 0
          PERFORM SQL-ERROR
       ELSE
       EXEC SQL
            OPEN C-DEPT-EMPLOYEE
       END-EXEC.
       IF SQLCODE NOT = 0
          PERFORM SQL-ERROR
       ELSE
       PERFORM FETCH-DEPT-EMPLOYEE

       IF SQLCODE = 100
       PERFORM EMPTY-SET
       ELSE
       PERFORM U020-VALID-HEADER
       MOVE HV-DEPARTMENT-DEPT-ID-0410 TO DEPT-ID-OUT
       MOVE HV-DEPARTMENT-DEPT-NAME-0410 TO DEPT-NAME-OUT
       MOVE DEPT-DETAIL-LINE TO PRINT-LINE
       PERFORM U000-WRITE-LINE
       PERFORM U030-EMP-HEADERS

       PERFORM UNTIL SQLCODE = 100
       PERFORM SET-WALK THRU SET-WALK-EXIT
       PERFORM FETCH-DEPT-EMPLOYEE
       END-PERFORM
       END-IF.
       EXEC SQL
            CLOSE C-DEPT-EMPLOYEE
       END-EXEC.
       END-IF.
       END-IF.
       END-IF.
       READ DEPT-FILE-IN
          AT END MOVE 'Y' TO EOF-SW.
DEPT-PROCESSING-EXIT.
       EXIT.
****************************************************************
* THIS PARAGRAPH RETRIEVES EMPLOYEE, JOB, AND OFFICE DATA *
* FOR EACH EMPLOYEE IN THE DEPT-EMPLOYEE SET. *
****************************************************************
SET-WALK.
       CONTINUE.
       MOVE HV-EMPLOYEE-EMP-ID-0415 TO ID-OUT.
       MOVE HV-EMPLOYEE-EMP-LAST-NAME-0415 TO LAST-OUT.
       MOVE HV-EMPLOYEE-EMP-FIRST-NAME-0415 TO FIRST-OUT.
       MOVE HV-EMPLOYEE-START-DATE-0415(3:2) TO SD-YY.
       MOVE HV-EMPLOYEE-START-DATE-0415(6:2) TO SD-MM.
       MOVE HV-EMPLOYEE-START-DATE-0415(9:2) TO SD-DD.
       EXEC SQL
                SELECT START_DATE_0420,
                FINISH_DATE_0420,
                SALARY_GRADE_0420,
                SALARY_AMOUNT_0420,
                BONUS_PERCENT_0420,
                COMMISSION_PERCENT_0420,
                OVERTIME_RATE_0420,
                EMP_ID_0415,
                JOB_ID_0440
            INTO :HV-EMPOSITION-START-DATE-0420,
                :HV-EMPOSITION-FINISH-DATE-0420 :NI-EMPOSITION-FINISH-DATE-0420,
                :HV-EMPOSITION-SALARY-GRADE-0420 :NI-EMPOSITION-SALARY-GRADE-0420,
                :HV-EMPOSITION-SALARY-AMOUNT-0420 :NI-EMPOSITION-SALARY-AMOUNT-0420,
                :HV-EMPOSITION-BONUS-PERCENT-0420 :NI-EMPOSITION-BONUS-PERCENT-0420,
                :HV-EMPOSITION-COMMISSION-PERCENT-0420 :NI-EMPOSITION-COMMISSION-PERCENT-0420,
                :HV-EMPOSITION-OVERTIME-RATE-0420 :NI-EMPOSITION-OVERTIME-RATE-0420,
                :HV-EMPOSITION-EMP-ID-0415 :NI-EMPOSITION-EMP-ID-0415,
                :HV-EMPOSITION-JOB-ID-0440 :NI-EMPOSITION-JOB-ID-0440
            FROM EMPOSITION
            WHERE EMP_ID_0415 = :HV-EMPLOYEE-EMP-ID-0415
            ORDER BY EMP_ID_0415
            FETCH FIRST 1 ROW ONLY
       END-EXEC.
       IF SQLCODE = 100
       MOVE NO-JOB-MESSAGE TO TITLE-OUT
       ELSE
       IF SQLCODE NOT = 0
          PERFORM SQL-ERROR
       ELSE
       EXEC SQL
                SELECT JOB_ID_0440,
                TITLE_0440,
                DESCRIPTION_LINE_0440,
                REQUIREMENT_LINE_0440,
                MINIMUM_SALARY_0440,
                MAXIMUM_SALARY_0440,
                SALARY_GRADES_0440,
                NUMBER_OF_POSITIONS_0440,
                NUMBER_OPEN_0440
            INTO :HV-JOB-JOB-ID-0440,
                :HV-JOB-TITLE-0440 :NI-JOB-TITLE-0440,
                :HV-JOB-DESCRIPTION-LINE-0440 :NI-JOB-DESCRIPTION-LINE-0440,
                :HV-JOB-REQUIREMENT-LINE-0440 :NI-JOB-REQUIREMENT-LINE-0440,
                :HV-JOB-MINIMUM-SALARY-0440 :NI-JOB-MINIMUM-SALARY-0440,
                :HV-JOB-MAXIMUM-SALARY-0440 :NI-JOB-MAXIMUM-SALARY-0440,
                :HV-JOB-SALARY-GRADES-0440 :NI-JOB-SALARY-GRADES-0440,
                :HV-JOB-NUMBER-OF-POSITIONS-0440 :NI-JOB-NUMBER-OF-POSITIONS-0440,
                :HV-JOB-NUMBER-OPEN-0440 :NI-JOB-NUMBER-OPEN-0440
            FROM JOB
            WHERE JOB_ID_0440 = :HV-EMPOSITION-JOB-ID-0440
       END-EXEC.
       IF SQLCODE = 100
       MOVE NO-JOB-MESSAGE TO TITLE-OUT
       ELSE
       IF SQLCODE NOT = 0
          PERFORM SQL-ERROR
       ELSE
       CONTINUE.
       END-IF.
       END-IF.
       END-IF.
       END-IF.
       MOVE HV-JOB-TITLE-0440 TO TITLE-OUT.
       IF NI-EMPLOYEE-OFFICE-CODE-0450 < 0
       MOVE NO-OFFICE-MESSAGE TO STREET-OUT
       MOVE SPACES TO CITY-OUT
       MOVE SPACES TO STATE-OUT
       MOVE SPACES TO ZIP-OUT
       ELSE
       EXEC SQL
                SELECT OFFICE_CODE_0450,
                OFFICE_STREET_0450,
                OFFICE_CITY_0450,
                OFFICE_STATE_0450,
                OFFICE_ZIP_FIRST_FIVE_0450,
                OFFICE_ZIP_LAST_FOUR_0450,
                OFFICE_PHONE_0450,
                OFFICE_AREA_CODE_0450,
                SPEED_DIAL_0450
            INTO :HV-OFFICE-OFFICE-CODE-0450,
                :HV-OFFICE-OFFICE-STREET-0450 :NI-OFFICE-OFFICE-STREET-0450,
                :HV-OFFICE-OFFICE-CITY-0450 :NI-OFFICE-OFFICE-CITY-0450,
                :HV-OFFICE-OFFICE-STATE-0450 :NI-OFFICE-OFFICE-STATE-0450,
                :HV-OFFICE-OFFICE-ZIP-FIRST-FIVE-0450 :NI-OFFICE-OFFICE-ZIP-FIRST-FIVE-0450,
                :HV-OFFICE-OFFICE-ZIP-LAST-FOUR-0450 :NI-OFFICE-OFFICE-ZIP-LAST-FOUR-0450,
                :HV-OFFICE-OFFICE-PHONE-0450 :NI-OFFICE-OFFICE-PHONE-0450,
                :HV-OFFICE-OFFICE-AREA-CODE-0450 :NI-OFFICE-OFFICE-AREA-CODE-0450,
                :HV-OFFICE-SPEED-DIAL-0450 :NI-OFFICE-SPEED-DIAL-0450
            FROM OFFICE
            WHERE OFFICE_CODE_0450 = :HV-EMPLOYEE-OFFICE-CODE-0450
       END-EXEC.
       IF SQLCODE = 0
       CONTINUE.
       ELSE
       MOVE NO-OFFICE-MESSAGE TO STREET-OUT
       MOVE SPACES TO CITY-OUT
       MOVE SPACES TO STATE-OUT
       MOVE SPACES TO ZIP-OUT
       END-IF.
       END-IF.
       MOVE HV-OFFICE-OFFICE-STREET-0450 TO STREET-OUT
       MOVE HV-OFFICE-OFFICE-CITY-0450 TO CITY-OUT
       MOVE HV-OFFICE-OFFICE-STATE-0450 TO STATE-OUT
       MOVE HV-OFFICE-OFFICE-ZIP-FIRST-FIVE-0450 TO ZIP-OUT
       MOVE EMP-DETAIL-LINE TO PRINT-LINE.
       PERFORM U000-WRITE-LINE.
SET-WALK-EXIT.
       EXIT.
END-PROCESSING.
       CLOSE DEPT-FILE-OUT.
       CLOSE ERR-FILE-OUT.
       CLOSE DEPT-FILE-IN.
EMPTY-SET.
       MOVE SPACES TO ERR-LINE.
       MOVE HV-DEPARTMENT-DEPT-ID-0410 TO ERR-ID-OUT.
       MOVE NO-EMP-MESSAGE TO ERR-MESS-OUT.
       MOVE ERR-DETAIL-LINE TO ERR-LINE.
       PERFORM U200-WRITE-ERR-LINE.
NO-DEPT-PROCESSING.
       MOVE DEPT-ID-IN TO ERR-ID-OUT.
       MOVE NO-DEPT-MESSAGE TO ERR-MESS-OUT.
       MOVE ERR-DETAIL-LINE TO ERR-LINE.
       PERFORM U200-WRITE-ERR-LINE.
U000-WRITE-LINE.
       WRITE DEPT-REC-OUT AFTER POSITIONING CC.
       IF CC = '1'
       THEN MOVE 0 TO LINE-COUNT
ELSE IF CC = ' '
       THEN ADD 1 TO LINE-COUNT
ELSE IF CC = '0'
       THEN ADD 2 TO LINE-COUNT.
       IF LINE-COUNT > LINE-MAX
       THEN PERFORM U010-NEW-PAGE-ROUTINE.
U010-NEW-PAGE-ROUTINE.
       PERFORM U020-VALID-HEADER.
       MOVE DEPT-DETAIL-LINE TO PRINT-LINE.
       PERFORM U000-WRITE-LINE.
       PERFORM U030-EMP-HEADERS.
U020-VALID-HEADER.
       MOVE DEPT-HEADER TO PRINT-LINE.
       MOVE '1' TO CC.
       PERFORM U000-WRITE-LINE.
       MOVE ' ' TO CC.
U030-EMP-HEADERS.
       MOVE '0' TO CC.
       MOVE EMP-HEADER TO PRINT-LINE.
       PERFORM U000-WRITE-LINE.
       MOVE SPACES TO PRINT-LINE.
       MOVE ' ' TO CC.
       PERFORM U000-WRITE-LINE.
U200-WRITE-ERR-LINE.
       WRITE ERR-REC-OUT AFTER POSITIONING ERR-CC.
       IF ERR-CC = '1'
       THEN MOVE 0 TO ERR-LINE-COUNT
ELSE IF ERR-CC = ' '
       THEN ADD 1 TO ERR-LINE-COUNT
ELSE IF ERR-CC = '0'
       THEN ADD 2 TO ERR-LINE-COUNT.
       IF ERR-LINE-COUNT > LINE-MAX
       THEN
       PERFORM U220-ERR-HEADER.
U220-ERR-HEADER.
       MOVE ERR-HEADER-1 TO ERR-LINE.
       MOVE '1' TO ERR-CC.
       PERFORM U200-WRITE-ERR-LINE.
       MOVE '0' TO ERR-CC.
       MOVE ERR-HEADER-2 TO ERR-LINE.
       PERFORM U200-WRITE-ERR-LINE.
       MOVE ERR-HEADER-3 TO ERR-LINE.
       PERFORM U200-WRITE-ERR-LINE.
       MOVE SPACES TO ERR-LINE.
       MOVE ' ' TO ERR-CC.
       PERFORM U200-WRITE-ERR-LINE.

SQL-ERROR.
       MOVE SPACES TO ERR-LINE.
       MOVE 'SQL ERROR' TO ERR-MESS-OUT.
       MOVE ERR-DETAIL-LINE TO ERR-LINE.
       PERFORM U200-WRITE-ERR-LINE.

SQL-ERROR-EXIT.
       EXIT.